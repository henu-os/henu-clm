# --- PAYMENT GATEWAYS (PROTECTED SERVER/EDGE ONLY) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=

# --- AI & THIRD PARTY INTEGRATIONS (SERVER-SIDE ONLY) ---
AI_PROVIDER_API_KEY=

# --- NOTIFICATIONS & COMMUNICATIONS (SERVER-SIDE ONLY) ---
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
FIREBASE_PROJECT_ID=

# --- DOCKER & DEPLOYMENT CONFIGURATION ---
HOST_PORT=3000
NODE_ENV=production
